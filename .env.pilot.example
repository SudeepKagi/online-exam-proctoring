# ProctorNet Local Pilot Environment Template (.env.pilot.example)
NODE_ENV=development
PORT=5000
INTERNAL_PORT=9100

# PostgreSQL Database (dedicated proctornet_pilot on port 5434)
DATABASE_URL=postgresql://proctornet:POSTGRES_PASSWORD@127.0.0.1:5434/proctornet_pilot?schema=public
DIRECT_URL=postgresql://proctornet:POSTGRES_PASSWORD@127.0.0.1:5434/proctornet_pilot?schema=public

# Redis L2 Cache & Socket.IO
REDIS_URL=redis://:REDIS_PASSWORD@127.0.0.1:6380
CACHE_DRIVER=redis
QUEUE_DRIVER=postgres
START_WORKERS=true

# Authentication & Security
JWT_SECRET=supersecret_jwt_proctornet_production_key_32bytes
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# CORS & Network Origins
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PUBLIC_ORIGIN must match the origin used by the browser/SEB to initiate API requests (Vite proxy port 5173)
PUBLIC_ORIGIN=http://localhost:5173

# Drivers & Storage
AWS_REGION=ap-south-1
S3_BUCKET=proctornet-storage
FACE_DRIVER=off
MEDIA_DRIVER=snapshot

# Safe Exam Browser (SEB) Settings
SEB_MODE=log
SEB_DEBUG_LOG_HASHES=true
SEB_CONFIG_KEY=PASTE_FROM_CONFIG_TOOL
