# ==============================================================================
# ProctorNet Frontend Build Environment Template (frontend/.env.example)
# Bundled into client assets by Vite at build time.
# ==============================================================================

# API & WebSocket Endpoints (proxied same-origin by Caddy reverse proxy)
VITE_API_URL=/api/v1
VITE_SOCKET_URL=

# Student Support & Helpdesk
VITE_SUPPORT_EMAIL=support@proctornet.duckdns.org
VITE_SUPPORT_URL=https://proctornet.duckdns.org/help

# Safe Exam Browser Downloads & Routing
VITE_SEB_DOWNLOAD_URL=https://safeexambrowser.org/download_en.html
VITE_SEB_QUIT_URL=/student/dashboard
# Optional global SEB configuration bundle download URL:
# VITE_SEB_CONFIG_URL=/downloads/proctornet.seb
