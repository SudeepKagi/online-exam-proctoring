# ==============================================================================
# ProctorNet Dedicated Test Environment Configuration (.env.test.example)
# Used exclusively by test runners (Vitest, Playwright, Node test runner).
# Copy to .env.test (gitignored). Must point strictly to a database ending in '_test'.
# ==============================================================================

NODE_ENV=test
PORT=5000
INTERNAL_PORT=9100

POSTGRES_PASSWORD=your_32char_hex_password_here
REDIS_PASSWORD=your_secure_test_redis_password_here

# Dedicated isolated test database on port 5434 (never points to dev or production)
DATABASE_URL="postgresql://proctornet:your_32char_hex_password_here@127.0.0.1:5434/proctornet_e2e_test?schema=public"
DIRECT_URL="postgresql://proctornet:your_32char_hex_password_here@127.0.0.1:5434/proctornet_e2e_test?schema=public"

# Test Redis cache on port 6380 (isolated from native host/WSL Redis on 6379)
REDIS_URL="redis://:your_secure_test_redis_password_here@127.0.0.1:6380"
CACHE_DRIVER=redis
QUEUE_DRIVER=postgres
START_WORKERS=true

# Proctoring drivers in test profile
FACE_DRIVER=off
FACE_VERIFIER_DRIVER=off
COOKIE_SECURE=false
E2E_PROFILE=prod-parity

# Frontend & Network
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_ORIGIN=http://localhost:5000

# Test JWT Secret
JWT_SECRET=supersecret_jwt_proctornet_production_key_32bytes

# Storage & Mock Adapter
S3_BUCKET=proctornet-storage
AWS_REGION=ap-south-1
S3_MOCK=true

# Safe Exam Browser (SEB) Settings
SEB_MODE=log
SEB_CONFIG_KEY=
SEB_LINK_SECRET=test_seb_link_secret_at_least_32_characters_long_for_hmac
SEB_PRE_DOWNLOAD_MINUTES=30

# Test-only cache TTL override (bypasses in-memory cache in test suites)
EXAM_CACHE_TTL_MS=0
