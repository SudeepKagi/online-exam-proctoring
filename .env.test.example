# ==============================================================================
# ProctorNet Dedicated Test Environment Configuration (.env.test.example)
# Used exclusively by test runners (Vitest, Playwright, Node test runner).
# Copy to .env.test (gitignored). Must point strictly to a database ending in '_test'.
# ==============================================================================

NODE_ENV=test
PORT=5000
INTERNAL_PORT=9100

# Dedicated isolated test database on port 5433 (never points to dev or production)
DATABASE_URL="postgresql://proctornet:proctornet_password@127.0.0.1:5433/proctornet_e2e_test?schema=public"
DIRECT_URL="postgresql://proctornet:proctornet_password@127.0.0.1:5433/proctornet_e2e_test?schema=public"

# Test Redis cache
REDIS_URL="redis://127.0.0.1:6379"
CACHE_DRIVER=redis
QUEUE_DRIVER=postgres
START_WORKERS=true

# Proctoring drivers in test profile
FACE_DRIVER=off
FACE_VERIFIER_DRIVER=off
COOKIE_SECURE=false
E2E_PROFILE=prod-parity

# Frontend & Network
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Test JWT Secret
JWT_SECRET=supersecret_jwt_proctornet_production_key_32bytes

# Storage
S3_BUCKET=proctornet-storage
AWS_REGION=ap-south-1
