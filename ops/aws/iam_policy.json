{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowObjectOperationsOnWhitelistedPrefixes",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::proctornet-*/evidence/*",
        "arn:aws:s3:::proctornet-*/identity/*",
        "arn:aws:s3:::proctornet-*/thumbs/*",
        "arn:aws:s3:::proctornet-*/questions/*"
      ]
    },
    {
      "Sid": "AllowListBucketWithPrefixRestriction",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::proctornet-*",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "evidence/*",
            "identity/*",
            "thumbs/*",
            "questions/*"
          ]
        }
      }
    }
  ]
}
