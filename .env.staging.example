# ==============================================================================
# ProctorNet Staging Environment Configuration Template (.env.staging.example)
# Do NOT paste actual staging secrets into git.
# Run 'node scripts/ops/init-env.js --staging --domain <staging-domain>' on the host.
# ==============================================================================

# Runtime & System
NODE_ENV=production
PORT=5000

# Canonical Public Identity
PUBLIC_HOST=staging.proctornet.duckdns.org
SITE_ADDRESS=staging.proctornet.duckdns.org
PUBLIC_ORIGIN=https://staging.proctornet.duckdns.org
ALLOWED_ORIGINS=https://staging.proctornet.duckdns.org

# Database Credentials & Connections (Group A generated / Group B decided)
POSTGRES_USER=proctornet
POSTGRES_PASSWORD=GENERATE_SECRET_MIN_32_CHARS
POSTGRES_DB=proctornet_staging
DATABASE_URL=postgresql://proctornet:POSTGRES_PASSWORD@postgres:5432/proctornet_staging?schema=public&connection_limit=30
DIRECT_URL=postgresql://proctornet:POSTGRES_PASSWORD@postgres:5432/proctornet_staging?schema=public

# Redis L2 Cache & Cluster Pub/Sub (Group A generated)
REDIS_PASSWORD=GENERATE_SECRET_MIN_32_CHARS
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379

# RabbitMQ Message Broker (Group A generated)
RABBITMQ_DEFAULT_USER=proctornet
RABBITMQ_DEFAULT_PASS=GENERATE_SECRET_MIN_32_CHARS
RABBITMQ_URL=amqp://proctornet:RABBITMQ_DEFAULT_PASS@rabbitmq:5672

# Application Cryptographic Secrets (Group A generated - min 32 chars, never default)
JWT_SECRET=GENERATE_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=GENERATE_SECRET_MIN_32_CHARS
SEB_LINK_SECRET=GENERATE_SECRET_MIN_32_CHARS
PII_ENCRYPTION_KEY=GENERATE_64_HEX_CHARS

# Operational Policies (Group B decided)
RETENTION_DAYS=90
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CACHE_DRIVER=redis
QUEUE_DRIVER=postgres
START_WORKERS=true
FACE_DRIVER=off
MEDIA_DRIVER=snapshot

# Safe Exam Browser Settings (Group B decided - log mode on staging)
SEB_MODE=log
SEB_CONFIG_KEY=OPTIONAL_64_HEX_KEY_FROM_SEB_CONFIG_TOOL
SEB_PRE_DOWNLOAD_MINUTES=30

# AWS S3 Object Storage (Group C from AWS)
S3_BUCKET=proctornet-storage-staging
AWS_REGION=ap-south-1
# When using EC2 IAM Instance Profile, leave access keys unset. If using IAM user:
# AWS_ACCESS_KEY_ID=REPLACE_ME_OR_USE_IAM_ROLE
# AWS_SECRET_ACCESS_KEY=REPLACE_ME_OR_USE_IAM_ROLE

