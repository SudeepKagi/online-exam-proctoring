# ==============================================================================
# ProctorNet Production Environment Configuration Template (.env.example)
# Phase P9 Task 3 — Zero Secrets in Git History (Kills Flaw C-01)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' (do NOT commit '.env' to git).
# 2. In Production (AWS), secrets MUST be managed via AWS Secrets Manager or
#    SSM Parameter Store, and S3 credentials via IAM Instance Profile Role.
# 3. Rotate secrets according to 'docs/runbooks/deploy.md'.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application & Runtime Settings
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://exam.university.edu
LOADTEST_ALLOW=0
START_WORKERS=true

# ------------------------------------------------------------------------------
# PostgreSQL Database (Appendix C Tuned)
# ------------------------------------------------------------------------------
POSTGRES_DB=proctornet
POSTGRES_USER=proctornet_admin
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=replace_with_strong_random_db_password_32_chars
DATABASE_URL=postgresql://proctornet_admin:${POSTGRES_PASSWORD}@postgres:5432/proctornet?schema=public&connection_limit=30
DIRECT_URL=postgresql://proctornet_admin:${POSTGRES_PASSWORD}@postgres:5432/proctornet

# ------------------------------------------------------------------------------
# Redis Fast State & Ephemeral Cache (Redis 7)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=replace_with_strong_random_redis_password_32_chars
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ------------------------------------------------------------------------------
# RabbitMQ Message Broker (RabbitMQ 3.12)
# ------------------------------------------------------------------------------
RABBITMQ_USER=proctornet_user
# Generate with: openssl rand -base64 32
RABBITMQ_PASSWORD=replace_with_strong_random_rabbitmq_password_32_chars
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672

# ------------------------------------------------------------------------------
# JWT Authentication & Cryptography
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_super_secret_jwt_hmac_key_at_least_64_bytes
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# Object Storage (AWS S3 or Local Dev MinIO)
# In AWS production: leave ACCESS_KEY empty and rely on IAM Instance Profile
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=proctornet-evidence-production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Local MinIO dev profile only:
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_with_strong_minio_root_password_32_chars
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ------------------------------------------------------------------------------
# LiveKit SFU WebRTC Media Server
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 16
LIVEKIT_API_KEY=replace_with_livekit_api_key_32_hex
# Generate with: openssl rand -base64 32
LIVEKIT_API_SECRET=replace_with_livekit_api_secret_at_least_32_bytes
LIVEKIT_URL=wss://exam.university.edu/livekit

# ------------------------------------------------------------------------------
# WireGuard VPN Module (Flag-Gated: default false)
# ------------------------------------------------------------------------------
VPN_ENABLED=false
VPN_ENFORCEMENT=warn
VPN_SERVER_IP=10.8.0.1
VPN_SERVER_PORT=51820
VPN_SERVER_PUBLIC_KEY=replace_with_wg_server_public_base64_key
VPN_INTERFACE=wg0
VPN_AGENT_SOCKET=/var/run/wireguard/vpn-agent.sock
# Generate with: openssl rand -hex 32
VPN_AGENT_SECRET=replace_with_vpn_agent_hmac_secret_64_hex

# ------------------------------------------------------------------------------
# Observability & Monitoring
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=replace_with_strong_grafana_admin_password_32_chars
PROMETHEUS_METRICS_PATH=/metrics

# ------------------------------------------------------------------------------
# CompreFace Facial Recognition (Profile: enrollment)
# ------------------------------------------------------------------------------
COMPREFACE_DB_PASSWORD=replace_with_compreface_db_password_32_chars
COMPREFACE_URL=http://compreface-admin:8080
COMPREFACE_API_KEY=replace_with_compreface_app_api_key
