# ProctorNet Production Environment Configuration Example
# Copy this file to .env and provide real credentials before starting the application

# Runtime & Server
NODE_ENV=production
PORT=5000
INTERNAL_PORT=9100

# PostgreSQL Database (Prisma ORM)
DATABASE_URL=postgresql://proctornet_user:secure_password_here@postgres-host:5432/proctornet?schema=public&connection_limit=30
DIRECT_URL=postgresql://proctornet_user:secure_password_here@postgres-host:5432/proctornet

# Redis L2 Cache & Socket.IO Multi-Node Clustering
REDIS_URL=redis://:redis_password_here@redis-host:6379
CACHE_DRIVER=redis
QUEUE_DRIVER=postgres
START_WORKERS=true

# Authentication & Security
JWT_SECRET=generate_a_secure_random_64_char_secret_for_production
JWT_EXPIRES_IN=7d
COOKIE_SECURE=true
BCRYPT_ROUNDS=12

# CORS & Network Origins
FRONTEND_URL=https://exam.institution.edu
ALLOWED_ORIGINS=https://exam.institution.edu

# AWS S3 Storage (Evidence & Live Proctoring Snapshots)
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=proctornet-production-storage
AWS_ACCESS_KEY_ID=your_production_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_production_aws_secret_access_key

# Face Verification & AWS Rekognition
FACE_DRIVER=rekognition
FACE_MATCH_THRESHOLD=80

# Error Tracking & Telemetry (Self-hosted or Cloud Sentry)
SENTRY_DSN=https://placeholder_key@sentry.io/project_id
