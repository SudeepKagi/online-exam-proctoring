# ==============================================================================
# ProctorNet Environment Configuration Template (.env.example)
# Copy this file to .env and configure before starting application services
# ==============================================================================

# Runtime & Server
NODE_ENV=production
PORT=5000
INTERNAL_PORT=9100

# Canonical Public Identity
PUBLIC_HOST=proctornet.duckdns.org
SITE_ADDRESS=proctornet.duckdns.org
PUBLIC_ORIGIN=https://proctornet.duckdns.org
ALLOWED_ORIGINS=https://proctornet.duckdns.org

# PostgreSQL Database (Prisma ORM)
POSTGRES_USER=proctornet
POSTGRES_PASSWORD=your_secure_postgres_password_min_32_chars
POSTGRES_DB=proctornet
DATABASE_URL=postgresql://proctornet:your_secure_postgres_password_min_32_chars@postgres:5432/proctornet?schema=public&connection_limit=30
DIRECT_URL=postgresql://proctornet:your_secure_postgres_password_min_32_chars@postgres:5432/proctornet?schema=public

# Redis L2 Cache & Socket.IO Multi-Node Clustering
REDIS_PASSWORD=your_secure_redis_password_min_32_chars
REDIS_URL=redis://:your_secure_redis_password_min_32_chars@redis:6379
CACHE_DRIVER=redis
QUEUE_DRIVER=postgres
START_WORKERS=true

# Authentication & Application Cryptographic Secrets
JWT_SECRET=your_production_jwt_signing_secret_at_least_32_chars!
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_at_least_32_chars!
SEB_LINK_SECRET=your_production_seb_launch_link_secret_at_least_32_chars!
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12

# AWS S3 Storage (Evidence & Proctoring Snapshots)
AWS_REGION=ap-south-1
S3_BUCKET=proctornet-storage
# AWS_ACCESS_KEY_ID=your_aws_access_key_id_if_not_using_iam_role
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_if_not_using_iam_role

# Operational Retention & Drivers
RETENTION_DAYS=90
FACE_DRIVER=off
MEDIA_DRIVER=snapshot

# Safe Exam Browser (SEB) Settings
# SEB_MODE: off | log | enforce
SEB_MODE=log
# Global fallback SEB Config Key (optional, 64-hex string)
# SEB_CONFIG_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SEB_PRE_DOWNLOAD_MINUTES=30
