{
  "name": "proctornet-root",
  "version": "1.0.0",
  "private": true,
  "description": "ProctorNet — Scalable Online Exam Proctoring System",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md}\"",
    "verify": "node scripts/ci/verify.js",
    "quality": "node scripts/ci/quality.js",
    "ci:local": "node scripts/ci/ci-local.js",
    "ci:doctor": "node scripts/ci/ci-doctor.js",
    "test": "node scripts/ci/run-tests.js",
    "test:e2e": "playwright test",
    "check:doc-links": "node scripts/ci/check-doc-links.js",
    "check:no-stubs": "node scripts/ci/check-no-stubs.js",
    "check:no-source-grep": "node scripts/ci/check-no-source-grep-tests.js",
    "check:ledger": "node scripts/ci/check-ledger.js",
    "stack:test:up": "docker compose -f docker-compose.test.yml up -d --build",
    "stack:test:down": "docker compose -f docker-compose.test.yml down -v",
    "lint": "npm run lint --prefix backend",
    "ops:reset-keep-admin": "npm run --prefix backend ops:reset-keep-admin",
    "ops:bootstrap-admin": "npm run --prefix backend ops:bootstrap-admin",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --workspace=frontend",
    "seed": "node backend/prisma/seed/admin.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@playwright/test": "^1.63.0",
    "@prisma/client": "^5.22.0",
    "acorn": "^8.19.0",
    "acorn-jsx": "^5.3.2",
    "acorn-walk": "^8.3.5",
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.0",
    "dotenv": "^18.0.7",
    "husky": "^9.1.7",
    "prettier": "^3.5.2",
    "prisma": "^5.22.0",
    "seedrandom": "^3.0.5",
    "socket.io-client": "^4.8.4",
    "yaml": "^2.9.1"
  }
}
