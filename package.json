{
  "name": "proctornet-root",
  "version": "1.0.0",
  "private": true,
  "description": "ProctorNet — Scalable Online Exam Proctoring System",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "db:migrate": "npx prisma migrate dev --schema=backend/prisma/schema.prisma",
    "db:migrate:deploy": "npx prisma migrate deploy --schema=backend/prisma/schema.prisma",
    "db:seed": "node backend/prisma/seed/admin.js",
    "test": "npm test --workspace=backend",
    "test:backend": "npm test --workspace=backend",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md}\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@playwright/test": "^1.63.0",
    "@prisma/client": "^5.22.0",
    "acorn": "^8.19.0",
    "acorn-jsx": "^5.3.2",
    "acorn-walk": "^8.3.5",
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.0",
    "dotenv": "^18.0.7",
    "husky": "^9.1.7",
    "prettier": "^3.5.2",
    "prisma": "^5.22.0",
    "seedrandom": "^3.0.5",
    "socket.io-client": "^4.8.4",
    "yaml": "^2.9.1"
  }
}
