{
  "name": "proctornet-root",
  "version": "1.0.0",
  "private": true,
  "description": "ProctorNet — Scalable Online Exam Proctoring System",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md}\"",
    "test": "node scripts/ci/run-tests.js",
    "test:e2e": "playwright test",
    "check:doc-links": "node scripts/ci/check-doc-links.js",
    "check:no-stubs": "node scripts/ci/check-no-stubs.js",
    "stack:test:up": "docker compose -f docker-compose.test.yml up -d --build",
    "stack:test:down": "docker compose -f docker-compose.test.yml down -v",
    "lint": "npm run lint --prefix proctornet/backend",
    "ops:reset-keep-admin": "npm run --prefix proctornet/backend ops:reset-keep-admin"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@playwright/test": "^1.63.0",
    "acorn": "^8.19.0",
    "acorn-jsx": "^5.3.2",
    "acorn-walk": "^8.3.5",
    "husky": "^9.1.7",
    "prettier": "^3.5.2",
    "seedrandom": "^3.0.5",
    "socket.io-client": "^4.8.4",
    "yaml": "^2.9.1"
  }
}
