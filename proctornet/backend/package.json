{
  "name": "proctornet-backend",
  "version": "1.0.0",
  "description": "ProctorNet Backend — Express API + Socket.io + Prisma ORM",
  "main": "src/app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "node --test tests/**/*.js",
    "lint": "eslint src/",
    "seed": "node prisma/seed/admin.js",
    "migrate": "npx prisma migrate dev",
    "migrate:deploy": "npx prisma migrate deploy",
    "generate": "npx prisma generate",
    "studio": "npx prisma studio",
    "ops:reset-keep-admin": "node scripts/ops/reset-keep-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-presigned-post": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "amqplib": "^2.2.0",
    "axios": "^1.4.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "livekit-server-sdk": "^2.19.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.9.3",
    "opossum": "^10.0.0",
    "p-limit": "^3.1.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^11.2.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.6.1",
    "ssh2": "^1.17.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "nodemon": "^3.0.1",
    "prisma": "^5.22.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
