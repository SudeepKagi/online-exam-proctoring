{
  "name": "proctornet-backend",
  "version": "1.0.0",
  "description": "ProctorNet Backend — Express API + Socket.io + Prisma ORM",
  "main": "src/app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --max-old-space-size=384 src/app.js",
    "start:standard": "node src/app.js",
    "dev": "UV_THREADPOOL_SIZE=4 nodemon --max-old-space-size=384 src/app.js",
    "test": "node --test tests/**/*.js",
    "lint": "eslint src/",
    "seed": "node prisma/seed/admin.js",
    "migrate": "npx prisma migrate dev",
    "migrate:deploy": "npx prisma migrate deploy",
    "generate": "npx prisma generate",
    "studio": "npx prisma studio",
    "ops:reset-keep-admin": "node scripts/ops/reset-keep-admin.js",
    "ops:dlq-replay": "node scripts/ops/dlq-replay.js",
    "ops:dead-replay": "node scripts/ops/dlq-replay.js",
    "ops:dead-replay-pg": "node -e \"require('./src/infra/postgres/pgQueueDispatcher').pgQueueDispatcher.replayFailed(200).then(r=>console.log('Replayed',r,'events')).catch(console.error).finally(()=>process.exit())\""
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1147.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-presigned-post": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.2.0",
    "axios": "^1.4.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "livekit-server-sdk": "^2.19.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.9.3",
    "opossum": "^10.0.0",
    "p-limit": "^3.1.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^11.2.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.6.1",
    "ssh2": "^1.17.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5",
    "prisma": "5.22.0"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "nodemon": "^3.0.1",
    "seedrandom": "^2.4.3",
    "undici": "^8.11.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
