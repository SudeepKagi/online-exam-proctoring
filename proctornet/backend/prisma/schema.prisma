generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// Native PostgreSQL Enums (P3 Domain Invariants)
// -------------------------------------------------------------

enum Role {
  ADMIN
  FACULTY
  STUDENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProfileStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
  LOCKED
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  LIVE
  ENDED
  EVALUATED
  RESULT_PUBLISHED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  READY
  ACTIVE
  SUBMITTED
  SUSPENDED
  TERMINATED
  EXPIRED
}

enum ResultStatus {
  CLEAN
  FLAGGED
  SUSPECTED
  DISQUALIFIED
}

enum ViolationType {
  TAB_SWITCH
  FULLSCREEN_EXIT
  MULTIPLE_FACES
  NO_FACE
  FACE_MISMATCH
  AUDIO_DETECTED
  VOICE_DETECTED
  SUSPICIOUS_OBJECT
  DEVTOOLS_OPENED
  KEYBOARD_SHORTCUT
  WINDOW_BLUR
  IP_CHANGE
  VM_DETECTED
  SCREEN_SHARE_STOPPED
  VPN_DISCONNECT
  VPN_IP_MISMATCH
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EvidenceStatus {
  NONE
  PENDING
  UPLOADED
  FAILED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

// -------------------------------------------------------------
// Canonical Lookup & Core Identity Models
// -------------------------------------------------------------

model Department {
  code      String   @id @db.VarChar(16)
  name      String   @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  students  Student[]
  faculties Faculty[]

  @@map("departments")
}

model Admin {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("admins")
}

model PlatformSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique
  value     String
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_settings")
}

model Faculty {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  email              String     @unique
  password           String
  departmentCode     String     @map("department_code") @db.VarChar(16)
  department         Department @relation(fields: [departmentCode], references: [code])
  employeeId         String     @unique @map("employee_id")
  phone              String?
  idCardPhotoKey     String?    @map("id_card_photo_key")
  profilePhotoKey    String?    @map("profile_photo_key")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  isApproved         Boolean    @default(true) @map("is_approved")
  approvedBy         String?    @map("approved_by") @db.Uuid
  approvedAt         DateTime?  @map("approved_at") @db.Timestamptz(3)
  isSuspended        Boolean    @default(false) @map("is_suspended")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  exams     Exam[]
  auditLogs AuditLog[]

  @@map("faculties")
}

model Student {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  usn                String         @unique
  email              String         @unique
  password           String
  departmentCode     String         @map("department_code") @db.VarChar(16)
  department         Department     @relation(fields: [departmentCode], references: [code])
  semester           Int            @default(1) @db.SmallInt
  phone              String?
  facePhotoKey       String?        @map("face_photo_key")
  idCardPhotoKey     String?        @map("id_card_photo_key")
  faceMatchScore     Float          @default(1.0) @map("face_match_score")
  mustChangePassword Boolean        @default(false) @map("must_change_password")
  approvalStatus     ApprovalStatus @default(APPROVED) @map("approval_status")
  approvedBy         String?        @map("approved_by") @db.Uuid
  approvedAt         DateTime?      @map("approved_at") @db.Timestamptz(3)
  isSuspended        Boolean        @default(false) @map("is_suspended")

  // Biometric Enrollment & Verification Fields
  profileStatus           ProfileStatus @default(PENDING) @map("profile_status")
  faceSubjectId           String?       @map("face_subject_id")
  faceEmbeddingRef        String?       @map("face_embedding_ref")
  idDocumentKey           String?       @map("id_document_key")
  idCroppedFaceKey        String?       @map("id_cropped_face_key")
  idOcrFields             Json?         @map("id_ocr_fields")
  consentTimestamp        DateTime?     @map("consent_timestamp") @db.Timestamptz(3)
  biometricEnrollDeadline DateTime?     @map("biometric_enroll_deadline") @db.Timestamptz(3)
  rejectionReason         String?       @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  attempts         ExamAttempt[]
  auditLogs        AuditLog[]
  verificationLogs VerificationAuditLog[]
  chatMessages     ChatMessage[]

  @@map("students")
}

// -------------------------------------------------------------
// Examination & Question Hierarchy (MCQ Only - ADR 002)
// -------------------------------------------------------------

model Exam {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title               String
  subject             String
  description         String?
  facultyId           String     @map("faculty_id") @db.Uuid
  faculty             Faculty    @relation(fields: [facultyId], references: [id])
  startTime           DateTime   @map("start_time") @db.Timestamptz(3)
  endTime             DateTime   @map("end_time") @db.Timestamptz(3)
  duration            Int        @default(60)
  totalMarks          Float      @default(100) @map("total_marks")
  negativeMarking     Boolean    @default(false) @map("negative_marking")
  negativeValue       Float      @default(0) @map("negative_value")
  questionsPerStudent Int        @default(0) @map("questions_per_student")
  randomiseQuestions  Boolean    @default(true) @map("randomise_questions")
  randomiseOptions    Boolean    @default(true) @map("randomise_options")
  allowedDepartments  String[]   @map("allowed_departments")
  allowedSemesters    Int[]      @map("allowed_semesters") @db.SmallInt
  invId               String     @unique @map("inv_id")
  invPasswordHash     String     @map("inv_password_hash")
  status              ExamStatus @default(DRAFT)

  // Proctoring Config
  cameraRequired     Boolean @default(true) @map("camera_required")
  micRequired        Boolean @default(false) @map("mic_required")
  browserLock        Boolean @default(true) @map("browser_lock")
  fullScreenMode     Boolean @default(true) @map("full_screen_mode")
  watermarkRequired  Boolean @default(true) @map("watermark_required")
  tabSwitchLimit     Int     @default(3) @map("tab_switch_limit")
  aiReverifyInterval Int     @default(10) @map("ai_reverify_interval")
  mobileDetectConfig Json?   @map("mobile_detect_config")
  vpnRequired        Boolean @default(false) @map("vpn_required")

  isPaused        Boolean  @default(false) @map("is_paused")
  pausedBy        String?  @map("paused_by") @db.Uuid
  pauseReason     String?  @map("pause_reason")
  resultsReleased Boolean  @default(false) @map("results_released")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  questions           Question[]
  attempts            ExamAttempt[]
  invigilatorSessions InvigilatorSession[]
  chatMessages        ChatMessage[]
  collusionReports    CollusionReport[]
  examResults         ExamResult[]

  @@index([allowedDepartments], type: Gin, map: "idx_exams_allowed_departments_gin")
  @@index([allowedSemesters], type: Gin, map: "idx_exams_allowed_semesters_gin")
  @@map("exams")
}

model Question {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId        String     @map("exam_id") @db.Uuid
  exam          Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionText  String     @map("question_text") @db.Text
  imageKey      String?    @map("image_key")
  marks         Float
  negativeMarks Float      @default(0) @map("negative_marks")
  difficulty    Difficulty @default(MEDIUM)
  order         Int        @default(0)
  tags          String[]
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  options          QuestionOption[]
  attemptQuestions AttemptQuestion[]

  @@index([examId], map: "idx_questions_exam_id")
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String   @db.Text
  isCorrect  Boolean  @default(false) @map("is_correct")
  order      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  answers Answer[]

  @@index([questionId])
  @@map("question_options")
}

// -------------------------------------------------------------
// Exam Attempts, Pre-Warming & Answer State Machine (ADR 012)
// -------------------------------------------------------------

model ExamAttempt {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId            String        @map("exam_id") @db.Uuid
  exam              Exam          @relation(fields: [examId], references: [id])
  studentId         String        @map("student_id") @db.Uuid
  student           Student       @relation(fields: [studentId], references: [id])
  status            AttemptStatus @default(READY)
  startedAt         DateTime?     @map("started_at") @db.Timestamptz(3)
  expiresAt         DateTime?     @map("expires_at") @db.Timestamptz(3)
  submittedAt       DateTime?     @map("submitted_at") @db.Timestamptz(3)
  suspendedAt       DateTime?     @map("suspended_at") @db.Timestamptz(3)
  totalSuspendedMs  Int           @default(0) @map("total_suspended_ms")
  watermarkSeed     String        @map("watermark_seed")
  shuffleSeed       String?       @map("shuffle_seed")
  flagCount         Int           @default(0) @map("flag_count")
  terminationReason String?       @map("termination_reason")
  revision          Int           @default(1)
  vpnIp             String?       @map("vpn_ip")
  vpnKeyExpiry      DateTime?     @map("vpn_key_expiry") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  attemptQuestions     AttemptQuestion[]
  answers              Answer[]
  violationEvents      ViolationEvent[]
  examResult           ExamResult?
  identityVerification IdentityVerification?
  reverifyLogs         ReverificationLog[]
  deviceCheckLogs      DeviceCheckLog[]

  @@unique([examId, studentId])
  @@index([examId, status], map: "idx_exam_attempts_exam_status")
  @@index([studentId, status], map: "idx_exam_attempts_student_status")
  @@map("exam_attempts")
}

model AttemptQuestion {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId    String      @map("attempt_id") @db.Uuid
  attempt      ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId   String      @map("question_id") @db.Uuid
  question     Question    @relation(fields: [questionId], references: [id])
  displayOrder Int         @map("display_order")
  optionOrder  Int[]       @map("option_order") @db.SmallInt

  answer Answer?

  @@unique([attemptId, displayOrder])
  @@unique([attemptId, questionId])
  @@unique([attemptId, id], map: "idx_attempt_questions_attempt_id_id")
  @@index([attemptId, displayOrder], map: "idx_attempt_questions_attempt_display")
  @@map("attempt_questions")
}

model Answer {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId         String          @map("attempt_id") @db.Uuid
  attempt           ExamAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptQuestionId String          @unique @map("attempt_question_id") @db.Uuid
  attemptQuestion   AttemptQuestion @relation(fields: [attemptId, attemptQuestionId], references: [attemptId, id], onDelete: Cascade)
  selectedOptionId  String?         @map("selected_option_id") @db.Uuid
  selectedOption    QuestionOption? @relation(fields: [selectedOptionId], references: [id])
  revision          Int             @default(1)
  savedAt           DateTime        @default(now()) @map("saved_at") @db.Timestamptz(3)
  timeTakenSecs     Int             @default(0) @map("time_taken_secs")
  autoScore         Float?          @map("auto_score")

  @@unique([attemptId, attemptQuestionId])
  @@index([attemptId], map: "idx_answers_attempt_id")
  @@map("answers")
}

model ExamResult {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId       String       @unique @map("attempt_id") @db.Uuid
  attempt         ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examId          String       @map("exam_id") @db.Uuid
  exam            Exam         @relation(fields: [examId], references: [id])
  score           Float        @default(0)
  totalMarks      Float        @map("total_marks")
  correctCount    Int          @default(0) @map("correct_count")
  wrongCount      Int          @default(0) @map("wrong_count")
  unansweredCount Int          @default(0) @map("unanswered_count")
  percentage      Float        @default(0)
  rank            Int?
  timeTaken       Int          @default(0) @map("time_taken")
  flagCount       Int          @default(0) @map("flag_count")
  status          ResultStatus @default(CLEAN)
  isReleased      Boolean      @default(false) @map("is_released")
  releasedAt      DateTime?    @map("released_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([examId], map: "idx_exam_results_exam_id")
  @@map("exam_results")
}

// -------------------------------------------------------------
// Append-Heavy Events & Streaming Timeline Stores (ADR 008)
// -------------------------------------------------------------

model ViolationEvent {
  id              BigInt         @id @default(autoincrement())
  attemptId       String         @map("attempt_id") @db.Uuid
  attempt         ExamAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  eventType       ViolationType  @map("event_type")
  severity        Severity
  serverTimestamp DateTime       @default(now()) @map("server_timestamp") @db.Timestamptz(3)
  clientTimestamp DateTime?      @map("client_timestamp") @db.Timestamptz(3)
  source          String         @default("CLIENT_EVENT")
  metadata        Json?
  evidenceKey     String?        @map("evidence_key")
  evidenceStatus  EvidenceStatus @default(NONE) @map("evidence_status")
  thumbKey        String?        @map("thumb_key")
  invAction       String?        @map("inv_action")
  invActionNote   String?        @map("inv_action_note")

  @@index([attemptId, serverTimestamp(sort: Desc)], map: "idx_violation_events_attempt_time")
  @@index([severity, serverTimestamp(sort: Desc)], map: "idx_violation_events_severity_time")
  @@map("violation_events")
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  actorId      String?  @map("actor_id") @db.Uuid
  actorRole    String   @map("actor_role")
  facultyId    String?  @map("faculty_id") @db.Uuid
  faculty      Faculty? @relation(fields: [facultyId], references: [id])
  studentId    String?  @map("student_id") @db.Uuid
  student      Student? @relation(fields: [studentId], references: [id])
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  attemptId    String?  @map("attempt_id") @db.Uuid
  requestId    String?  @map("request_id")
  metadata     Json?
  ipAddress    String?  @map("ip_address")
  timestamp    DateTime @default(now()) @db.Timestamptz(3)

  @@index([actorId, id(sort: Desc)], map: "idx_audit_logs_actor_id")
  @@index([resourceType, resourceId, id(sort: Desc)], map: "idx_audit_logs_resource")
  @@map("audit_logs")
}

model ChatMessage {
  id         BigInt   @id @default(autoincrement())
  examId     String   @map("exam_id") @db.Uuid
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId  String   @map("student_id") @db.Uuid
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  senderRole String   @map("sender_role")
  message    String   @db.Text
  timestamp  DateTime @default(now()) @db.Timestamptz(3)
  isRead     Boolean  @default(false) @map("is_read")

  @@index([examId, studentId, id], map: "idx_chat_messages_exam_student_id")
  @@map("chat_messages")
}

model OutboxEvent {
  id            BigInt       @id @default(autoincrement())
  eventType     String       @map("event_type")
  payload       Json
  status        OutboxStatus @default(PENDING)
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  attempts      Int          @default(0)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(3)

  @@map("outbox_events")
}

model IdempotencyKey {
  scope          String   @default("global") @db.VarChar(64)
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([scope, key])
  @@map("idempotency_keys")
}

model ProcessedEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String   @map("event_id")
  handlerName String   @map("handler_name")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@unique([eventId, handlerName])
  @@map("processed_events")
}

// -------------------------------------------------------------
// Network & Telemetry Infrastructure (ADR 010 & P8)
// -------------------------------------------------------------

model VpnIpPool {
  ip         String    @id @map("ip")
  attemptId  String?   @unique @map("attempt_id") @db.Uuid
  leasedAt   DateTime? @map("leased_at") @db.Timestamptz(3)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(3)

  @@map("vpn_ip_pool")
}

model VpnPeer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId String?  @map("attempt_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  ipAddress String   @map("ip_address")
  publicKey String   @unique @map("public_key")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([attemptId], map: "idx_vpn_peers_attempt_id")
  @@index([ipAddress], map: "idx_vpn_peers_ip_address")
  @@map("vpn_peers")
}

// -------------------------------------------------------------
// Biometric, Hardware Integrity & Invigilation Logs
// -------------------------------------------------------------

model IdentityVerification {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId          String      @unique @map("attempt_id") @db.Uuid
  attempt            ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  liveFaceMatchScore Float       @map("live_face_match_score")
  idCardOcrUsn       String?     @map("id_card_ocr_usn")
  idCardMatchResult  Boolean     @map("id_card_match_result")
  faceWithIdKey      String      @map("face_with_id_key")
  verifiedAt         DateTime    @default(now()) @map("verified_at") @db.Timestamptz(3)
  status             String

  @@map("identity_verifications")
}

model VerificationAuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptId String?  @map("attempt_id") @db.Uuid
  checkType String   @map("check_type")
  score     Float?
  status    String
  details   String?
  timestamp DateTime @default(now()) @db.Timestamptz(3)

  @@map("verification_audit_logs")
}

model ReverificationLog {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId      String      @map("attempt_id") @db.Uuid
  attempt        ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  checkTime      DateTime    @default(now()) @map("check_time") @db.Timestamptz(3)
  faceMatchScore Float       @map("face_match_score")
  result         String
  cameraFrameKey String?     @map("camera_frame_key")

  @@map("reverification_logs")
}

model DeviceCheckLog {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId        String       @map("student_id") @db.Uuid
  attemptId        String?      @map("attempt_id") @db.Uuid
  attempt          ExamAttempt? @relation(fields: [attemptId], references: [id])
  agentConnected   Boolean      @default(true) @map("agent_connected")
  blockedProcesses String[]     @map("blocked_processes")
  virtualCams      String[]     @map("virtual_cams")
  isSubnetMatched  Boolean      @default(true) @map("is_subnet_matched")
  clientIp         String?      @map("client_ip")
  status           String       @default("PASSED")
  timestamp        DateTime     @default(now()) @db.Timestamptz(3)

  @@map("device_check_logs")
}

model InvigilatorSession {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId          String   @map("exam_id") @db.Uuid
  exam            Exam     @relation(fields: [examId], references: [id])
  invId           String   @map("inv_id")
  idCardPhotoKey  String   @map("id_card_photo_key")
  idCardOcrResult String?  @map("id_card_ocr_result")
  loginTime       DateTime @default(now()) @map("login_time") @db.Timestamptz(3)
  sessionExpiry   DateTime @map("session_expiry") @db.Timestamptz(3)
  ipAddress       String?  @map("ip_address")
  isActive        Boolean  @default(true) @map("is_active")

  @@map("invigilator_sessions")
}

model CollusionReport {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId               String   @map("exam_id") @db.Uuid
  exam                 Exam     @relation(fields: [examId], references: [id])
  student1Id           String   @map("student1_id") @db.Uuid
  student2Id           String   @map("student2_id") @db.Uuid
  similarityScore      Float    @map("similarity_score")
  commonQuestions      String[] @map("common_questions")
  matchingWrongAnswers String[] @map("matching_wrong_answers")
  isFlagged            Boolean  @default(true) @map("is_flagged")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("collusion_reports")
}

model Announcement {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  message          String
  postedBy         String   @map("posted_by") @db.Uuid
  target           String
  targetDepartment String?  @map("target_department")
  priority         String   @default("NORMAL")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  readBy           String[] @map("read_by")

  @@map("announcements")
}

model BiometricOverrideLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  approverId String   @map("approver_id") @db.Uuid
  reason     String
  prevStatus String   @map("prev_status")
  newStatus  String   @map("new_status")
  timestamp  DateTime @default(now()) @db.Timestamptz(3)

  @@map("biometric_override_logs")
}
