# ==============================================================================
# ProctorNet Backend Development Environment Template (backend/.env.example)
# For local standalone backend development outside Docker
# ==============================================================================

PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL + Prisma)
DATABASE_URL=postgresql://proctornet:password@127.0.0.1:5432/proctornet_dev?schema=public
DIRECT_URL=postgresql://proctornet:password@127.0.0.1:5432/proctornet_dev?schema=public

# Redis L2 Cache
REDIS_URL=redis://:password@127.0.0.1:6379
CACHE_DRIVER=redis

# Application Cryptographic Secrets (≥32 characters)
JWT_SECRET=dev_jwt_secret_must_be_at_least_32_characters_long_for_signing!
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_at_least_32_characters_long_for_dev!
SEB_LINK_SECRET=dev_seb_link_secret_at_least_32_characters_long_for_hmac!

# CORS & Network Origins
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_ORIGIN=http://localhost:5173

# S3 & Drivers
AWS_REGION=ap-south-1
S3_BUCKET=proctornet-storage-dev
# For local MinIO S3 emulation:
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_FORCE_PATH_STYLE=true

# Safe Exam Browser Settings
SEB_MODE=log
# SEB_CONFIG_KEY=
