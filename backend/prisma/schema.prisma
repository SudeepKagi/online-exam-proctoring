generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// Enums
// -------------------------------------------------------------

enum Role {
  ADMIN
  FACULTY
  INVIGILATOR
  STUDENT
}

enum UserStatus {
  PENDING_SETUP
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  SUSPENDED
  TIMED_OUT
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// -------------------------------------------------------------
// 1. User
// -------------------------------------------------------------

model User {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId      String?    @map("institution_id")
  email              String     @unique
  passwordHash       String     @map("password_hash")
  fullName           String     @map("full_name")
  role               Role       @default(STUDENT)
  status             UserStatus @default(PENDING_SETUP)
  referencePhotoKey  String?    @map("reference_photo_key")
  idCardPhotoKey     String?    @map("id_card_photo_key")
  profileMetadata    Json?      @map("profile_metadata")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  createdExams       Exam[]           @relation("ExamCreator")
  assignments        ExamAssignment[]
  attempts           ExamAttempt[]

  @@map("users")
}

// -------------------------------------------------------------
// 2. Exam
// -------------------------------------------------------------

model Exam {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  courseCode       String     @map("course_code")
  createdById      String     @map("created_by_id") @db.Uuid
  creator          User       @relation("ExamCreator", fields: [createdById], references: [id], onDelete: Cascade)
  startTime        DateTime   @map("start_time") @db.Timestamptz(3)
  endTime          DateTime   @map("end_time") @db.Timestamptz(3)
  durationMinutes  Int        @default(60) @map("duration_minutes")
  status           ExamStatus @default(DRAFT)
  proctoringConfig Json?      @map("proctoring_config")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  questions        Question[]
  assignments      ExamAssignment[]
  attempts         ExamAttempt[]

  @@map("exams")
}

// -------------------------------------------------------------
// 3. Question
// -------------------------------------------------------------

model Question {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId             String   @map("exam_id") @db.Uuid
  exam               Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionText       String   @map("question_text") @db.Text
  options            Json
  correctOptionIndex Int      @map("correct_option_index")
  marks              Float    @default(1)
  negativeMarks      Float    @default(0) @map("negative_marks")
  displayOrder       Int      @default(0) @map("display_order")

  answers            AttemptAnswer[]

  @@map("questions")
}

// -------------------------------------------------------------
// 4. ExamAssignment
// -------------------------------------------------------------

model ExamAssignment {
  examId       String   @map("exam_id") @db.Uuid
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedRole Role     @default(STUDENT) @map("assigned_role")

  @@id([examId, userId])
  @@map("exam_assignments")
}

// -------------------------------------------------------------
// 5. ExamAttempt
// -------------------------------------------------------------

model ExamAttempt {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId         String        @map("exam_id") @db.Uuid
  exam           Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId      String        @map("student_id") @db.Uuid
  student        User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status         AttemptStatus @default(NOT_STARTED)
  faceVerified   Boolean       @default(false) @map("face_verified")
  startedAt      DateTime?     @map("started_at") @db.Timestamptz(3)
  expiresAt      DateTime?     @map("expires_at") @db.Timestamptz(3)
  submittedAt    DateTime?     @map("submitted_at") @db.Timestamptz(3)
  score          Float?        @default(0)
  violationCount Int           @default(0) @map("violation_count")

  answers        AttemptAnswer[]
  proctoringLogs ProctoringLog[]

  @@unique([examId, studentId])
  @@map("exam_attempts")
}

// -------------------------------------------------------------
// 6. AttemptAnswer
// -------------------------------------------------------------

model AttemptAnswer {
  attemptId           String      @map("attempt_id") @db.Uuid
  attempt             ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId          String      @map("question_id") @db.Uuid
  question            Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionIndex Int?        @map("selected_option_index")
  isBookmarked        Boolean     @default(false) @map("is_bookmarked")
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([attemptId, questionId])
  @@map("attempt_answers")
}

// -------------------------------------------------------------
// 7. ProctoringLog
// -------------------------------------------------------------

model ProctoringLog {
  id          BigInt      @id @default(autoincrement())
  attemptId   String      @map("attempt_id") @db.Uuid
  attempt     ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  eventType   String      @map("event_type")
  severity    Severity    @default(MEDIUM)
  evidenceKey String?     @map("evidence_key")
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("proctoring_logs")
}
